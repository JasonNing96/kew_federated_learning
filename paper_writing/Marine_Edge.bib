@inproceedings{fengFederatedOptimalFramework2023,
  title = {Federated {{Optimal Framework}} with {{Low-bitwidth Quantization}} for {{Distribution System}}},
  booktitle = {{{GLOBECOM}} 2023 - 2023 {{IEEE Global Communications Conference}}},
